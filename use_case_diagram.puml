@startuml use_case_diagram

skinparam handwritten false
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11

skinparam actor {
    BackgroundColor #E8F0FE
    BorderColor #1A73E8
    FontColor #202124
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #1A73E8
    FontColor #202124
}

skinparam rectangle {
    BackgroundColor #F8F9FA
    BorderColor #5F6368
    FontColor #202124
    FontSize 14
    FontStyle bold
}

title **Internal Microservice Catalog & Health Portal**\n**UML Use-Case Diagram**\n<size:11>Subramani B M  |  PES1UG24CS473  |  Section H  |  PES University</size>\n

top to bottom direction

' ══════════════════════════════════════════════
' ACTORS — Top (DevOps left, Architect right)
' ══════════════════════════════════════════════
actor "DevOps Engineer" as DevOps
actor "System Architect" as Architect
DevOps -[hidden]right- Architect

' ══════════════════════════════════════════════
' SYSTEM BOUNDARY
' ══════════════════════════════════════════════
rectangle "Internal Microservice Catalog & Health Portal" {

    ' ── Row 1: Primary Use Cases ──
    ' Ordered left → right: DevOps-only, Shared, Architect-only
    ' This minimizes line crossings from actors above.
    usecase "UC-001\nRegister & Update\nMicroservice" as UC1
    usecase "UC-006\nConfigure Alert\nChannels" as UC6
    usecase "UC-004\nMonitor Service\nHealth" as UC4
    usecase "UC-002\nSearch & Filter\nCatalog" as UC2
    usecase "UC-005\nBrowse API\nDocumentation" as UC5
    usecase "UC-003\nView Dependency\nGraph" as UC3

    ' Force horizontal ordering
    UC1 -[hidden]right- UC6
    UC6 -[hidden]right- UC4
    UC4 -[hidden]right- UC2
    UC2 -[hidden]right- UC5
    UC5 -[hidden]right- UC3

    ' ── Row 2: Supporting Use Cases ──
    usecase "UC-008\nValidate Service\nMetadata" as UC_Validate
    usecase "UC-007\nAuthenticate via\nEnterprise SSO" as UC_Auth
    usecase "UC-009\nDispatch Downtime\nAlert" as UC_Alert

    UC_Validate -[hidden]right- UC_Auth
    UC_Auth -[hidden]right- UC_Alert
}

' ══════════════════════════════════════════════
' EXTERNAL ACTOR — Bottom
' ══════════════════════════════════════════════
actor "Notification Service\n<<external system>>" as NotifSvc

' ── DevOps Engineer Associations ──
DevOps -- UC1
DevOps -- UC6
DevOps -- UC4
DevOps -- UC2
DevOps -- UC5

' ── System Architect Associations ──
Architect -- UC2
Architect -- UC3
Architect -- UC5

' ── «include» Relationships ──
UC1 ..> UC_Validate : <<include>>
UC1 ..> UC_Auth    : <<include>>
UC4 ..> UC_Auth    : <<include>>

' ── «extend» Relationship ──
UC_Alert ..> UC4 : <<extend>>

' ── External System Association ──
UC_Alert -- NotifSvc

@enduml
