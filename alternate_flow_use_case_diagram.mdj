        {
          "_type": "UMLUseCase",
          "_id": "AAAAAGSALTUC0009",
          "_parent": { "$ref": "AAAAAGSALTMODEL0001" },
          "name": "UC-004e: Mark Service Healthy & Reset Failure Counter",
