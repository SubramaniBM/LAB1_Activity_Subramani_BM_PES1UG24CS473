{
  "_type": "Project",
  "_id": "AAAAAGSCOMP_PROJECT_001",
  "name": "InternalMicroserviceCatalog_ComponentModeling",
  "ownedElements": [
    {
      "_type": "UMLModel",
      "_id": "AAAAAGSMODEL_COMP_001",
      "_parent": { "$ref": "AAAAAGSCOMP_PROJECT_001" },
      "name": "MicroserviceCatalog_ComponentArchitecture",
      "ownedElements": [
        {
          "_type": "UMLComponent",
          "_id": "COMP_APIGATEWAY",
          "_parent": { "$ref": "AAAAAGSMODEL_COMP_001" },
          "name": "API Gateway & Authentication Service",
          "documentation": "Provides reverse proxy, TLS 1.2+ termination, SSO OAuth2/SAML authentication, rate limiting, and request routing to backend microservices."
        },
        {
          "_type": "UMLComponent",
          "_id": "COMP_CATALOG",
          "_parent": { "$ref": "AAAAAGSMODEL_COMP_001" },
          "name": "Catalog & Registry Management Service",
          "documentation": "Manages searchable service registration, metadata schemas (owner, version, repository URL), and full-text search indexing."
        },
        {
          "_type": "UMLComponent",
          "_id": "COMP_HEALTH",
          "_parent": { "$ref": "AAAAAGSMODEL_COMP_001" },
          "name": "Health Monitoring & Periodic Pinger Service",
          "documentation": "Runs automated 30-second ping loops against target microservice health endpoints, computes rolling 24-hour availability percentages, and triggers alerts on 3 consecutive failures."
        },
        {
          "_type": "UMLComponent",
          "_id": "COMP_GRAPH",
          "_parent": { "$ref": "AAAAAGSMODEL_COMP_001" },
          "name": "Dependency Mapping & Graph Engine",
          "documentation": "Discovers upstream/downstream relationships and renders an interactive graph supporting 200+ microservice nodes within 2 seconds."
        },
        {
          "_type": "UMLComponent",
          "_id": "COMP_DOCS",
          "_parent": { "$ref": "AAAAAGSMODEL_COMP_001" },
          "name": "API Documentation Aggregator Service",
          "documentation": "Aggregates, parses, and serves OpenAPI/Swagger 3.0 specifications for registered microservices."
        },
        {
          "_type": "UMLComponent",
          "_id": "COMP_ALERT",
          "_parent": { "$ref": "AAAAAGSMODEL_COMP_001" },
          "name": "Alerting & Notification Dispatcher Service",
          "documentation": "Consumes outage events and routes real-time alerts via Slack Webhooks, PagerDuty, and SMTP Email to on-call contacts within 60 seconds."
        },
        {
          "_type": "UMLComponent",
          "_id": "COMP_EVENTBUS",
          "_parent": { "$ref": "AAAAAGSMODEL_COMP_001" },
          "name": "Event Broker / Message Bus",
          "documentation": "Asynchronous messaging backbone (AMQP / RabbitMQ) decoupling health monitoring probes from alerting and notification dispatch."
        },
        {
          "_type": "UMLComponent",
          "_id": "COMP_PERSISTENCE",
          "_parent": { "$ref": "AAAAAGSMODEL_COMP_001" },
          "name": "Polyglot Persistence Layer",
          "documentation": "Encapsulates PostgreSQL for catalog metadata, TimescaleDB for health time-series metrics, Neo4j for topological dependency graphs, and Redis for caching."
        },
        {
          "_type": "UMLInterface",
          "_id": "IFACE_PORTAL_GATEWAY",
