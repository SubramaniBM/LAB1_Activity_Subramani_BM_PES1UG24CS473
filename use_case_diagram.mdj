{
  "_type": "Project",
  "_id": "AAAAAGSPROJECT00001",
  "name": "InternalMicroserviceCatalogHealthPortal",
  "ownedElements": [
    {
      "_type": "UMLModel",
      "_id": "AAAAAGSMODEL000001",
      "_parent": { "$ref": "AAAAAGSPROJECT00001" },
      "name": "Model",
      "ownedElements": [
        {
          "_type": "UMLActor",
          "_id": "AAAAAGSACTOR00001",
          "_parent": { "$ref": "AAAAAGSMODEL000001" },
          "name": "DevOps Engineer",
          "documentation": "Primary actor responsible for registering microservices, monitoring health, configuring alerts, and browsing API documentation."
        },
        {
          "_type": "UMLActor",
          "_id": "AAAAAGSACTOR00002",
          "_parent": { "$ref": "AAAAAGSMODEL000001" },
          "name": "System Architect",
          "documentation": "Actor responsible for viewing dependency graphs, searching the service catalog, and browsing API documentation."
        },
        {
          "_type": "UMLActor",
          "_id": "AAAAAGSACTOR00003",
          "_parent": { "$ref": "AAAAAGSMODEL000001" },
          "name": "Notification Service",
          "stereotype": "external system",
          "documentation": "External system that delivers downtime alert notifications via Email, Slack, and Webhook."
        },
        {
          "_type": "UMLUseCase",
          "_id": "AAAAAGSUSECASE0001",
          "_parent": { "$ref": "AAAAAGSMODEL000001" },
          "name": "UC-001: Register & Update Microservice",
          "documentation": "The system shall maintain a catalog where DevOps engineers can register new microservices and update existing metadata."
        },
        {
          "_type": "UMLUseCase",
          "_id": "AAAAAGSUSECASE0002",
          "_parent": { "$ref": "AAAAAGSMODEL000001" },
          "name": "UC-002: Search & Filter Service Catalog",
          "documentation": "The system shall provide searchable and filterable access to all registered microservices and their metadata."
        },
        {
          "_type": "UMLUseCase",
          "_id": "AAAAAGSUSECASE0003",
          "_parent": { "$ref": "AAAAAGSMODEL000001" },
          "name": "UC-003: View Dependency Graph",
          "documentation": "The system shall render an interactive dependency graph showing upstream and downstream relationships among microservices."
        },
        {
          "_type": "UMLUseCase",
          "_id": "AAAAAGSUSECASE0004",
          "_parent": { "$ref": "AAAAAGSMODEL000001" },
          "name": "UC-004: Monitor Service Health & Availability",
          "documentation": "The system shall ping microservice health endpoints at 30-second intervals and compute rolling 24-hour service availability percentages."
        },
        {
          "_type": "UMLUseCase",
          "_id": "AAAAAGSUSECASE0005",
          "_parent": { "$ref": "AAAAAGSMODEL000001" },
          "name": "UC-005: Browse API Documentation",
          "documentation": "The system shall aggregate and display auto-generated API documentation (OpenAPI/Swagger specs) for each microservice."
        },
        {
          "_type": "UMLUseCase",
          "_id": "AAAAAGSUSECASE0006",
          "_parent": { "$ref": "AAAAAGSMODEL000001" },
          "name": "UC-006: Configure Alert Channels",
          "documentation": "The system shall allow DevOps engineers to configure notification channels (Email, Slack, Webhook) and on-call contacts per microservice."
        },
        {
          "_type": "UMLUseCase",
          "_id": "AAAAAGSUSECASE0007",
          "_parent": { "$ref": "AAAAAGSMODEL000001" },
          "name": "UC-007: Authenticate via Enterprise SSO",
          "documentation": "The system shall authenticate users via enterprise SSO (OAuth 2.0 / SAML) before granting access to portal features."
        },
        {
          "_type": "UMLUseCase",
          "_id": "AAAAAGSUSECASE0008",
          "_parent": { "$ref": "AAAAAGSMODEL000001" },
          "name": "UC-008: Validate Service Metadata",
          "documentation": "The system shall validate the completeness and correctness of microservice metadata and health endpoint URLs upon registration."
        },
        {
          "_type": "UMLUseCase",
          "_id": "AAAAAGSUSECASE0009",
          "_parent": { "$ref": "AAAAAGSMODEL000001" },
          "name": "UC-009: Dispatch Downtime Alert",
          "documentation": "The system shall dispatch real-time downtime alert notifications to on-call contacts when 3 consecutive health probes fail."
        },
