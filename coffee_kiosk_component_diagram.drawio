<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.7.6">
  <diagram id="component-diagram-kiosk" name="UML Component Diagram - Coffee Kiosk">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- HEADER -->
        <mxCell id="kiosk_header" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1480" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="kiosk_header_text" value="&lt;font color=&quot;#ffffff&quot; style=&quot;font-size:20px&quot;&gt;&lt;b&gt;Self-Service Coffee Kiosk System&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#38bdf8&quot; style=&quot;font-size:14px&quot;&gt;&lt;b&gt;UML 2.5 Component Diagram — Layered / Client-Server Architecture&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#cbd5e1&quot; style=&quot;font-size:12px&quot;&gt;Student: &lt;b&gt;Subramani B M&lt;/b&gt; &amp;nbsp;|&amp;nbsp; SRN: &lt;b&gt;PES1UG24CS473&lt;/b&gt; &amp;nbsp;|&amp;nbsp; Section: &lt;b&gt;H&lt;/b&gt; &amp;nbsp;|&amp;nbsp; Lab 3 Architecture Deliverable&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="25" width="1440" height="80" as="geometry"/>
        </mxCell>

        <!-- BOUNDARY -->
        <mxCell id="kiosk_boundary" value="&lt;font style=&quot;font-size:14px&quot;&gt;&lt;b&gt;System Boundary: Kiosk Local Application Runtime&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=2;strokeDashed=1;verticalAlign=top;align=left;spacingLeft=25;spacingTop=15;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="260" y="140" width="1050" height="840" as="geometry"/>
        </mxCell>

        <!-- ACTOR: Customer -->
        <mxCell id="actor_customer" value="&lt;b&gt;Café Customer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#64748b;&quot;&gt;Touch Interaction&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="90" y="320" width="50" height="85" as="geometry"/>
        </mxCell>

        <!-- COMPONENT 1: Touchscreen UI -->
        <mxCell id="comp_kiosk_ui" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;&amp;laquo;component&amp;raquo;&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;&quot;&gt;Touchscreen UI&lt;br&gt;Component&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#bae6fd;&quot;&gt;&lt;p style=&quot;margin:0;margin-left:8px;font-size:10px;text-align:left;color:#0369a1;&quot;&gt;• Drink Selector (Espresso, Latte, Americano)&lt;br&gt;• Size Selector (Small, Large)&lt;br&gt;• Order Summary &amp;amp; Pay Button&lt;/p&gt;" style="html=1;dropTarget=0;whiteSpace=wrap;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.8;shape=component;align=center;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="310" y="300" width="220" height="150" as="geometry"/>
        </mxCell>

        <!-- Customer to UI -->
        <mxCell id="edge_cust_ui" value="" style="endArrow=open;dashed=1;html=1;strokeWidth=1.5;strokeColor=#0284c7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endFill=0;" edge="1" parent="1" source="actor_customer" target="comp_kiosk_ui">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- COMPONENT 2: Order Manager Component -->
        <mxCell id="comp_kiosk_om" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;&amp;laquo;component&amp;raquo;&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;&quot;&gt;Order Manager&lt;br&gt;Component&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#bbf7d0;&quot;&gt;&lt;p style=&quot;margin:0;margin-left:8px;font-size:10px;text-align:left;color:#166534;&quot;&gt;• Order Lifecycle &amp;amp; State Machine&lt;br&gt;• Total Bill Calculation &amp;amp; Tax&lt;br&gt;• Coordinates Payment &amp;amp; Printing&lt;/p&gt;" style="html=1;dropTarget=0;whiteSpace=wrap;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.8;shape=component;align=center;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="680" y="300" width="230" height="150" as="geometry"/>
        </mxCell>

        <!-- Interface 1: IOrderService (Ball from Order Manager, Socket from UI) -->
        <mxCell id="iface_order_prov" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="365" width="20" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="lbl_iface_order" value="&lt;b&gt;IOrderService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569;&quot;&gt;placeOrder(), calculateTotal()&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=bottom;fontSize=10;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="530" y="325" width="160" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="conn_om_order_prov" value="" style="endArrow=none;html=1;strokeWidth=1.8;strokeColor=#16a34a;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="iface_order_prov" target="comp_kiosk_om">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="sock_ui_order" value="" style="shape=arc;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#0284c7;fillColor=none;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="590" y="362" width="26" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="conn_ui_sock" value="" style="endArrow=none;html=1;strokeWidth=1.8;strokeColor=#0284c7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="comp_kiosk_ui" target="sock_ui_order">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- COMPONENT 3: Payment Service Component -->
        <mxCell id="comp_kiosk_payment" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;&amp;laquo;component&amp;raquo;&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;&quot;&gt;Payment Service&lt;br&gt;Component&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#fed7aa;&quot;&gt;&lt;p style=&quot;margin:0;margin-left:8px;font-size:10px;text-align:left;color:#9a3412;&quot;&gt;• Card Reader Hardware Interface&lt;br&gt;• Tokenization &amp;amp; PCI-DSS Compliance&lt;br&gt;• Transaction Auth &amp;amp; Verification&lt;/p&gt;" style="html=1;dropTarget=0;whiteSpace=wrap;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=1.8;shape=component;align=center;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1060" y="300" width="220" height="150" as="geometry"/>
        </mxCell>

        <!-- Interface 2: IPaymentProcessor -->
        <mxCell id="iface_pay_prov" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="990" y="365" width="20" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="lbl_iface_pay" value="&lt;b&gt;IPaymentProcessor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569;&quot;&gt;authorize(), chargeCard()&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=bottom;fontSize=10;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="920" y="325" width="160" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="conn_pay_prov" value="" style="endArrow=none;html=1;strokeWidth=1.8;strokeColor=#ea580c;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="iface_pay_prov" target="comp_kiosk_payment">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="sock_om_pay" value="" style="shape=arc;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#16a34a;fillColor=none;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="980" y="362" width="26" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="conn_om_pay_sock" value="" style="endArrow=none;html=1;strokeWidth=1.8;strokeColor=#16a34a;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="comp_kiosk_om" target="sock_om_pay">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- COMPONENT 4: Receipt Printer Controller Component -->
        <mxCell id="comp_kiosk_printer" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;&amp;laquo;component&amp;raquo;&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;&quot;&gt;Receipt Printer&lt;br&gt;Controller Component&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#fecdd3;&quot;&gt;&lt;p style=&quot;margin:0;margin-left:8px;font-size:10px;text-align:left;color:#be123c;&quot;&gt;• ESC/POS Thermal Print Protocol&lt;br&gt;• Formats Itemized Order Receipt&lt;br&gt;• Hardware Status (Out of Paper check)&lt;/p&gt;" style="html=1;dropTarget=0;whiteSpace=wrap;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=1.8;shape=component;align=center;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="680" y="580" width="230" height="150" as="geometry"/>
        </mxCell>

        <!-- Interface 3: IPrinterDriver -->
        <mxCell id="iface_print_prov" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#e11d48;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="785" y="520" width="20" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="lbl_iface_print" value="&lt;b&gt;IPrinterDriver&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569;&quot;&gt;printReceipt(orderDetails)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=bottom;fontSize=10;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="670" y="500" width="150" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="conn_print_prov" value="" style="endArrow=none;html=1;strokeWidth=1.8;strokeColor=#e11d48;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="iface_print_prov" target="comp_kiosk_printer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="sock_om_print" value="" style="shape=arc;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#16a34a;fillColor=none;rotation=0;" vertex="1" parent="1">
          <mxGeometry x="782" y="510" width="26" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="conn_om_print_sock" value="" style="endArrow=none;html=1;strokeWidth=1.8;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="comp_kiosk_om" target="sock_om_print">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- COMPONENT 5: Menu & Pricing Database Component -->
        <mxCell id="comp_kiosk_db" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;&amp;laquo;component&amp;raquo;&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;&quot;&gt;Menu &amp;amp; Pricing&lt;br&gt;Database Component&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#e9d5ff;&quot;&gt;&lt;p style=&quot;margin:0;margin-left:8px;font-size:10px;text-align:left;color:#6b21a8;&quot;&gt;• SQLite Embedded Local Datastore&lt;br&gt;• Coffee Types (Espresso, Latte, Americano)&lt;br&gt;• Size Multipliers &amp;amp; Current Prices&lt;/p&gt;" style="html=1;dropTarget=0;whiteSpace=wrap;fillColor=#faf5ff;strokeColor=#9333ea;strokeWidth=1.8;shape=component;align=center;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="310" y="580" width="220" height="150" as="geometry"/>
        </mxCell>

        <!-- Interface 4: IMenuData -->
        <mxCell id="iface_menu_prov" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#9333ea;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="410" y="515" width="20" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="lbl_iface_menu" value="&lt;b&gt;IMenuData&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#475569;&quot;&gt;getMenu(), getPrice()&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=bottom;fontSize=10;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="320" y="495" width="140" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="conn_menu_prov" value="" style="endArrow=none;html=1;strokeWidth=1.8;strokeColor=#9333ea;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="iface_menu_prov" target="comp_kiosk_db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="sock_ui_menu" value="" style="shape=arc;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#0284c7;fillColor=none;rotation=0;" vertex="1" parent="1">
          <mxGeometry x="407" y="505" width="26" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="conn_ui_menu_sock" value="" style="endArrow=none;html=1;strokeWidth=1.8;strokeColor=#0284c7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="comp_kiosk_ui" target="sock_ui_menu">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- EXTERNAL HARDWARE & PAYMENT GATEWAY -->
        <!-- Card Reader Device -->
        <mxCell id="hw_card_reader" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;&amp;laquo;hardware&amp;raquo;&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Card Reader PinPad&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;margin-left:6px;font-size:9px;color:#475569;&quot;&gt;USB / Serial EMV Chip&lt;/p&gt;" style="html=1;dropTarget=0;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=1.5;shape=component;align=center;" vertex="1" parent="1">
          <mxGeometry x="1370" y="320" width="160" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="edge_pay_hw" value="&amp;laquo;use&amp;raquo; USB Driver" style="endArrow=open;dashed=1;html=1;strokeWidth=1.5;strokeColor=#ea580c;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endFill=0;" edge="1" parent="1" source="comp_kiosk_payment" target="hw_card_reader">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Thermal Receipt Printer -->
        <mxCell id="hw_printer_dev" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;&amp;laquo;hardware&amp;raquo;&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;Thermal Printer&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;margin-left:6px;font-size:9px;color:#475569;&quot;&gt;ESC/POS Serial/USB&lt;/p&gt;" style="html=1;dropTarget=0;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=1.5;shape=component;align=center;" vertex="1" parent="1">
          <mxGeometry x="980" y="600" width="160" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="edge_print_hw" value="&amp;laquo;use&amp;raquo; ESC/POS" style="endArrow=open;dashed=1;html=1;strokeWidth=1.5;strokeColor=#e11d48;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endFill=0;" edge="1" parent="1" source="comp_kiosk_printer" target="hw_printer_dev">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- LEGEND -->
        <mxCell id="kiosk_legend" value="&lt;b&gt;UML 2.5 Component Diagram Notation Legend (Coffee Kiosk Scenario)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#334155;&quot;&gt;● &lt;b&gt;5 Components&lt;/b&gt;: Touchscreen UI, Order Manager, Payment Service, Receipt Printer Controller, Menu &amp;amp; Pricing DB.&lt;br&gt;● &lt;b&gt;4 Key Interfaces&lt;/b&gt;: IOrderService, IPaymentProcessor, IPrinterDriver, IMenuData using standard provided (ball) &amp;amp; required (socket) notation.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=1.2;align=left;spacingLeft=15;spacingTop=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="890" width="1480" height="70" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
