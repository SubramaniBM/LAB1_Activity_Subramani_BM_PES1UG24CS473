<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.7.6">
  <diagram id="alt-flow-use-case-diagram" name="Alternate Flow Use-Case Diagram">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1550" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ═══════════ HEADER / TITLE ═══════════ -->
        <mxCell id="2" value="&lt;font style=&quot;font-size:17px&quot;&gt;&lt;b&gt;Internal Microservice Catalog &amp;amp; Health Portal&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Alternate Flow UML Use-Case Diagram — Outage Detection &amp;amp; Recovery (UC-004)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Subramani B M &amp;nbsp;|&amp;nbsp; PES1UG24CS473 &amp;nbsp;|&amp;nbsp; Section H &amp;nbsp;|&amp;nbsp; PES University&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="385" y="10" width="650" height="70" as="geometry"/>
        </mxCell>

        <!-- ═══════════ SYSTEM BOUNDARY ═══════════ -->
        <mxCell id="3" value="&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Health Monitoring &amp;amp; Outage Alerting Subsystem (Alternate Flow Boundary)&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#5f6368;verticalAlign=top;align=center;spacingTop=10;dashed=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="190" y="90" width="1040" height="760" as="geometry"/>
        </mxCell>

        <!-- ═══════════ ACTORS ═══════════ -->
        <!-- DevOps Engineer (Left side) -->
        <mxCell id="10" value="&lt;b&gt;DevOps Engineer&lt;/b&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#e8f0fe;strokeColor=#1a73e8;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="50" y="270" width="40" height="75" as="geometry"/>
        </mxCell>

        <!-- Notification Service (Right side) -->
        <mxCell id="12" value="&lt;b&gt;Notification Service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;«external system»&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#fce8e6;strokeColor=#d93025;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1300" y="380" width="40" height="75" as="geometry"/>
        </mxCell>

        <!-- ═══════════ TOP ROW: BASE USE CASE (UC-004) & SSO ═══════════ -->
        <mxCell id="20" value="&lt;b&gt;UC-004&lt;/b&gt;&lt;br&gt;Monitor Microservice&lt;br&gt;Health (Base Flow)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;fontSize=11;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="240" y="140" width="190" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="21" value="&lt;b&gt;UC-007&lt;/b&gt;&lt;br&gt;Authenticate via&lt;br&gt;Enterprise SSO" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f3e8fd;strokeColor=#7627bb;fontSize=11;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="580" y="140" width="190" height="65" as="geometry"/>
        </mxCell>

        <!-- ═══════════ MIDDLE ROW: FAILURE DETECTION & INCIDENT LOGGING ═══════════ -->
        <mxCell id="22" value="&lt;b&gt;UC-004a&lt;/b&gt;&lt;br&gt;Detect Probe Failure &amp;amp;&lt;br&gt;Increment Counter" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#d93025;fontSize=11;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="240" y="275" width="190" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="23" value="&lt;b&gt;UC-004b&lt;/b&gt;&lt;br&gt;Mark Service Down &amp;amp;&lt;br&gt;Log Outage Incident" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#d93025;fontSize=11;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="580" y="275" width="190" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="24" value="&lt;b&gt;UC-009&lt;/b&gt;&lt;br&gt;Dispatch Real-Time&lt;br&gt;Downtime Alert" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#d93025;fontSize=11;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="920" y="275" width="190" height="65" as="geometry"/>
        </mxCell>

        <!-- ═══════════ NOTIFICATION MULTI-CHANNEL DELIVERY ═══════════ -->
        <mxCell id="25" value="&lt;b&gt;UC-009a&lt;/b&gt;&lt;br&gt;Deliver Notifications&lt;br&gt;(Email / Slack / Webhook)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#d93025;fontSize=11;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="920" y="390" width="190" height="65" as="geometry"/>
        </mxCell>

        <!-- ═══════════ INCIDENT ANALYSIS BY DEVOPS ═══════════ -->
        <mxCell id="26" value="&lt;b&gt;UC-004c&lt;/b&gt;&lt;br&gt;Analyze Incident &amp;amp;&lt;br&gt;Dependency Impact" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;fontSize=11;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="240" y="440" width="190" height="65" as="geometry"/>
        </mxCell>

        <!-- ═══════════ BOTTOM ROW: RECOVERY & RESTORATION ═══════════ -->
        <mxCell id="27" value="&lt;b&gt;UC-004d&lt;/b&gt;&lt;br&gt;Detect Probe Success &amp;amp;&lt;br&gt;Calculate Downtime" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#137333;fontSize=11;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="240" y="580" width="190" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="28" value="&lt;b&gt;UC-004e&lt;/b&gt;&lt;br&gt;Mark Service Healthy &amp;amp;&lt;br&gt;Reset Failure Counter" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#137333;fontSize=11;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="580" y="580" width="190" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="29" value="&lt;b&gt;UC-009b&lt;/b&gt;&lt;br&gt;Dispatch Service&lt;br&gt;Recovery Notification" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#137333;fontSize=11;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="920" y="580" width="190" height="65" as="geometry"/>
        </mxCell>

        <!-- ═══════════ ACTOR ASSOCIATIONS ═══════════ -->
        <!-- DevOps associations -->
        <mxCell id="30" style="endArrow=none;html=1;rounded=0;strokeWidth=1.4;strokeColor=#202124;" edge="1" source="10" target="20" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="31" style="endArrow=none;html=1;rounded=0;strokeWidth=1.4;strokeColor=#202124;" edge="1" source="10" target="26" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Notification Service associations -->
        <mxCell id="32" style="endArrow=none;html=1;rounded=0;strokeWidth=1.4;strokeColor=#202124;" edge="1" source="25" target="12" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="33" style="endArrow=none;html=1;rounded=0;strokeWidth=1.4;strokeColor=#202124;" edge="1" source="29" target="12" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ═══════════ RELATIONSHIPS: INCLUDE / EXTEND ═══════════ -->
        <!-- UC-004 -> UC-007 (include SSO) -->
        <mxCell id="40" value="«include»" style="html=1;dashed=1;endArrow=open;endFill=0;endSize=10;strokeWidth=1.3;fontSize=10;fontStyle=1;strokeColor=#7627bb;" edge="1" source="20" target="21" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- UC-004a -> UC-004 (extend on probe fail < 3) -->
        <mxCell id="41" value="«extend»&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Single Probe Failed]&lt;/font&gt;" style="html=1;dashed=1;endArrow=open;endFill=0;endSize=10;strokeWidth=1.3;fontSize=10;fontStyle=1;strokeColor=#d93025;" edge="1" source="22" target="20" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- UC-004a -> UC-004b (include when failures == 3) -->
        <mxCell id="42" value="«include»&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[3 Consecutive Fails]&lt;/font&gt;" style="html=1;dashed=1;endArrow=open;endFill=0;endSize=10;strokeWidth=1.3;fontSize=10;fontStyle=1;strokeColor=#d93025;" edge="1" source="22" target="23" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- UC-009 -> UC-004b (extend: trigger downtime alert) -->
        <mxCell id="43" value="«extend»&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Outage Trigger]&lt;/font&gt;" style="html=1;dashed=1;endArrow=open;endFill=0;endSize=10;strokeWidth=1.3;fontSize=10;fontStyle=1;strokeColor=#d93025;" edge="1" source="24" target="23" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- UC-009 -> UC-009a (include: multi-channel dispatch) -->
        <mxCell id="44" value="«include»" style="html=1;dashed=1;endArrow=open;endFill=0;endSize=10;strokeWidth=1.3;fontSize=10;fontStyle=1;strokeColor=#d93025;" edge="1" source="24" target="25" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- UC-004d -> UC-004 (extend on probe recovery) -->
        <mxCell id="45" value="«extend»&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Probe 200 OK Received]&lt;/font&gt;" style="html=1;dashed=1;endArrow=open;endFill=0;endSize=10;strokeWidth=1.3;fontSize=10;fontStyle=1;strokeColor=#137333;" edge="1" source="27" target="26" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- UC-004d -> UC-004e (include state restoration) -->
        <mxCell id="46" value="«include»" style="html=1;dashed=1;endArrow=open;endFill=0;endSize=10;strokeWidth=1.3;fontSize=10;fontStyle=1;strokeColor=#137333;" edge="1" source="27" target="28" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- UC-004e -> UC-009b (include recovery alert) -->
        <mxCell id="47" value="«include»" style="html=1;dashed=1;endArrow=open;endFill=0;endSize=10;strokeWidth=1.3;fontSize=10;fontStyle=1;strokeColor=#137333;" edge="1" source="28" target="29" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ═══════════ LEGEND ═══════════ -->
        <mxCell id="50" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Legend (Alternate Flow Lifecycle)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1a73e8&quot;&gt;■&lt;/font&gt; Blue = Base Monitoring &amp;amp; DevOps Interaction Use Cases&lt;br&gt;&lt;font color=&quot;#d93025&quot;&gt;■&lt;/font&gt; Red = Failure Detection &amp;amp; Outage Alerting Flow (Steps 5a–5f)&lt;br&gt;&lt;font color=&quot;#137333&quot;&gt;■&lt;/font&gt; Green = Automatic Recovery &amp;amp; Restoration Flow (Step 5g)&lt;br&gt;&lt;font color=&quot;#7627bb&quot;&gt;■&lt;/font&gt; Purple = Cross-Cutting SSO Authentication&lt;br&gt;&lt;br&gt;─── Solid line = Actor Association &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; - - - Dashed arrow = Dependency («include» / «extend»)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#dadce0;spacingLeft=10;spacingTop=6;spacingRight=10;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="240" y="675" width="530" height="135" as="geometry"/>
        </mxCell>

      </root>
